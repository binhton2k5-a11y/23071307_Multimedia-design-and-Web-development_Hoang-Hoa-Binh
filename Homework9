declare(strict_types=1);
error_reporting(E_ALL);
ini_set('display_errors', '0');
date_default_timezone_set('Asia/Ho_Chi_Minh');

// Convert unexpected PHP warnings/notices into catchable exceptions.
set_error_handler(function ($severity, $message, $file, $line) {
    if (!(error_reporting() & $severity)) {
        return false;
    }
    throw new ErrorException($message, 0, $severity, $file, $line);
});

class DivisionByZeroException extends Exception {}
class InvalidOperatorException extends Exception {}
class InvalidInputException extends Exception {}
// OverflowException is provided by PHP's SPL; do not redeclare it.

function escapeHtml($value): string
{
    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function postedText(string $key): string
{
    $value = $_POST[$key] ?? '';
    return is_string($value) ? $value : '[invalid array input]';
}

function parseNumber(string $key, string $label): float
{
    $value = $_POST[$key] ?? null;
    if (!is_string($value) || trim($value) === '' || strlen($value) > 128
        || !is_numeric(trim($value))) {
        throw new InvalidInputException($label . ' must be a number, such as 12 or -3.5.');
    }
    $number = (float) trim($value);
    if (is_infinite($number) || is_nan($number)) {
        throw new OverflowException($label . ' is outside the supported numeric range. Use a smaller number.');
    }
    return $number;
}

function calculate(float $a, string $operator, float $b): float
{
    if (!in_array($operator, ['+', '-', '*', '/', '%', '**'], true)) {
        throw new InvalidOperatorException('Choose a supported operator: +, -, *, /, %, or **.');
    }
    if (($operator === '/' || $operator === '%') && $b == 0.0) {
        throw new DivisionByZeroException(
            $operator === '/' ? 'Cannot divide by zero. Enter a non-zero second number.'
                : 'Cannot calculate modulo by zero. Enter a non-zero second number.'
        );
    }
    // PHP % converts operands to integers. Reject fractions and out-of-range
    // casts explicitly, avoiding truncation and float-to-int warnings.
    if ($operator === '%') {
        foreach ([$a, $b] as $operand) {
            if (floor($operand) !== $operand || $operand >= (float) PHP_INT_MAX
                || $operand < (float) PHP_INT_MIN) {
                throw new InvalidInputException('Modulo requires whole numbers within the PHP integer range. Try 10 % 3.');
            }
        }
    }
    // Zero to a negative power is also a division by zero.
    if ($operator === '**' && $a == 0.0 && $b < 0.0) {
        throw new DivisionByZeroException('Zero cannot have a negative exponent. Use a non-zero base or a non-negative exponent.');
    }
    switch ($operator) {
        case '+': $result = $a + $b; break;
        case '-': $result = $a - $b; break;
        case '*': $result = $a * $b; break;
        case '/': $result = $a / $b; break;
        case '%': $result = (int) $a % (int) $b; break;
        case '**': $result = $a ** $b; break;
        default: throw new InvalidOperatorException('Please select a valid operator.');
    }
    if (is_infinite((float) $result) || is_nan((float) $result)) {
        throw new OverflowException('The result is too large or is not a finite real number. Try smaller numbers or a different exponent.');
    }
    return (float) $result;
}

function logCaughtError(Throwable $error, string $expression): bool
{
    // A .log extension alone does NOT protect a file served by Apache.
    // Keep the log in a sibling directory of the document root instead.
    try {
        $documentRoot = realpath($_SERVER['DOCUMENT_ROOT'] ?? '');
        if ($documentRoot === false || $documentRoot === '' || dirname($documentRoot) === $documentRoot) {
            throw new RuntimeException('A valid document root is required for private logging.');
        }
        $directory = dirname($documentRoot) . DIRECTORY_SEPARATOR . 'ins3064-homework09-private';
        if (!is_dir($directory) && !mkdir($directory, 0700, true) && !is_dir($directory)) {
            throw new RuntimeException('Cannot create the private log directory.');
        }
        // JSON escaping keeps untrusted text on one physical log line.
        $encoded = json_encode($expression, JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
        $message = str_replace(["\r", "\n"], ['\\r', '\\n'], $error->getMessage());
        $ip = $_SERVER['REMOTE_ADDR'] ?? 'unknown';
        $ip = filter_var($ip, FILTER_VALIDATE_IP) ? $ip : 'unknown';
        $entry = sprintf("[%s] %s: %s | Input: %s | IP: %s\n",
            date('Y-m-d H:i:s'), get_class($error), $message, $encoded, $ip);
        return file_put_contents($directory . '/calculator_errors.log', $entry, FILE_APPEND | LOCK_EX) !== false;
    } catch (Throwable $loggingError) {
        // Do not let a logging failure expose a stack trace or hide the original error.
        try {
            error_log('Homework 9 logging failure: ' . $loggingError->getMessage()
                . ' | Original: ' . get_class($error) . ': ' . $error->getMessage());
        } catch (Throwable $ignored) {
            // The friendly warning below still tells the user logging is unavailable.
        }
        return false;
    }
}

$operators = ['+' => 'Add (+)', '-' => 'Subtract (-)', '*' => 'Multiply (*)',
    '/' => 'Divide (/)', '%' => 'Modulo (%)', '**' => 'Power (**)'];
$first = '';
$second = '';
$operator = '+';
$expression = '';
$result = null;
$errorMessage = '';
$warningMessage = '';
$caughtError = null;
$history = [];

try {
    // Start the session before any HTML output.
    session_start();
    if (!isset($_SESSION['history']) || !is_array($_SESSION['history'])) {
        $_SESSION['history'] = [];
    }
    if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
        $first = postedText('first_number');
        $second = postedText('second_number');
        $operator = postedText('operator');
        $expression = trim($first) . ' ' . $operator . ' ' . trim($second);
        $action = $_POST['action'] ?? 'calculate';
        if ($action === 'clear_history') {
            $_SESSION['history'] = [];
            $warningMessage = 'Calculation history cleared. You can start a new calculation.';
        } elseif ($action === 'calculate') {
            $a = parseNumber('first_number', 'First number');
            $b = parseNumber('second_number', 'Second number');
            $value = calculate($a, $operator, $b);
            // Required display rule: division has four decimals; others show integers.
            $result = number_format($value, $operator === '/' ? 4 : 0, '.', '');
            if ((float) $result == 0.0) {
                $result = $operator === '/' ? '0.0000' : '0';
            }
            if ($operator !== '/' && floor($value) !== $value) {
                $warningMessage = 'The result is rounded to a whole number for display, as required by this homework.';
            }
            $_SESSION['history'][] = [
                'expression' => $expression,
                'result' => $result,
                'timestamp' => date('Y-m-d H:i:s'),
            ];
        } else {
            throw new InvalidInputException('Unknown form action. Please use Calculate or Clear History.');
        }
    }
} catch (InvalidInputException $error) {
    $caughtError = $error;
    $errorMessage = $error->getMessage();
} catch (InvalidOperatorException $error) {
    $caughtError = $error;
    $errorMessage = $error->getMessage();
} catch (DivisionByZeroException $error) {
    $caughtError = $error;
    $errorMessage = $error->getMessage();
} catch (OverflowException $error) {
    $caughtError = $error;
    $errorMessage = $error->getMessage();
} catch (Throwable $error) {
    $caughtError = $error;
    $errorMessage = 'Something unexpected went wrong. Please reload the page and try again.';
}
if ($caughtError !== null && !logCaughtError($caughtError, $expression)) {
    $warningMessage = 'The calculation error was handled, but the private log could not be saved. Please ask the administrator to check folder permissions.';
}
if (isset($_SESSION['history']) && is_array($_SESSION['history'])) {
    $history = array_reverse($_SESSION['history']);
}
