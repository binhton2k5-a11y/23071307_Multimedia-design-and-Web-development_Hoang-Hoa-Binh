function calculateAverage(array $scores): float
{
    $scoreCount = count($scores);

    if ($scoreCount === 0) {
        return 0.0;
    }

    $total = 0;
    for ($index = 0; $index < $scoreCount; $index++) {
        $total += $scores[$index];
    }

    return round($total / $scoreCount, 1);
}

function assignGrade(float $average): string
{
    if ($average >= 9) {
        return 'A';
    } elseif ($average >= 8) {
        return 'B';
    } elseif ($average >= 7) {
        return 'C';
    } elseif ($average >= 6) {
        return 'D';
    } else {
        return 'F';
    }
}

function gradeClass(string $grade): string
{
    return 'grade-' . strtolower($grade);
}

function escapeHtml(string $value): string
{
    return htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
}

$results = [];
foreach ($students as $originalIndex => $student) {
    $scores = $student['scores'];
    $average = calculateAverage($scores);

    $results[] = [
        'name' => $student['name'],
        'scores' => $scores,
        'average' => $average,
        'highest' => count($scores) > 0 ? max($scores) : 0,
        'lowest' => count($scores) > 0 ? min($scores) : 0,
        'grade' => assignGrade($average),
        'original_index' => $originalIndex,
    ];
}

usort($results, function (array $firstStudent, array $secondStudent): int {
    if ($firstStudent['average'] === $secondStudent['average']) {
        return $firstStudent['original_index'] <=> $secondStudent['original_index'];
    }

    return $secondStudent['average'] <=> $firstStudent['average'];
});
