-- Query 6: Books Above Average Price
-- Description: List all books whose price is higher than the overall average price.
SELECT 
    b.title AS book_title,
    b.price AS price
FROM books b
WHERE b.price > (
    SELECT AVG(price)
    FROM books
)
ORDER BY b.price DESC, b.title ASC;

