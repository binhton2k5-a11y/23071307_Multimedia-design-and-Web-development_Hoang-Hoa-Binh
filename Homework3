<fieldset class="field"><legend>Interests (choose at least one)</legend><div class="choices"><?php foreach ($interestOptions as $interest): ?><label><input type="checkbox" name="interests[]" value="<?php echo escapeHtml($interest); ?>" <?php echo in_array($interest, $surveyValues['interests'], true) ? 'checked' : ''; ?>> <?php echo escapeHtml($interest); ?></label><?php endforeach; ?></div><?php if (isset($errors['interests'])): ?><span class="error"><?php echo escapeHtml($errors['interests']); ?></span><?php endif; ?></fieldset><button type="submit">View my summary</button></form></div>
