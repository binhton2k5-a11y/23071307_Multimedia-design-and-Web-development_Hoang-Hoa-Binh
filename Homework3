<?php
session_start();

function escapeHtml(string $value): string {
    return htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
}

$step = $_GET['step'] ?? 'register';
$validSteps = ['register', 'survey', 'summary'];
if (!in_array($step, $validSteps, true)) $step = 'register';

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['start_over'])) {
    $_SESSION = [];
    session_destroy();
    header('Location: homework3.php?step=register');
    exit;
}

// Survey and summary require the registration step to be completed.
if (in_array($step, ['survey', 'summary'], true) && (!isset($_SESSION['registration']) || !is_array($_SESSION['registration']))) {
    header('Location: homework3.php?step=register');
    exit;
}
if ($step === 'summary' && (!isset($_SESSION['survey']) || !is_array($_SESSION['survey']))) {
    header('Location: homework3.php?step=survey');
    exit;
}

$errors = [];
$registrationValues = ['name' => '', 'email' => '', 'age' => '', 'gender' => ''];
$languages = ['PHP', 'JavaScript', 'Python', 'Java', 'C++', 'Other'];
$experiences = ['Beginner', 'Intermediate', 'Advanced'];
$interestOptions = ['Web Development', 'Mobile Apps', 'Data Science', 'Cybersecurity', 'AI/ML', 'Game Development'];
$surveyValues = ['language' => '', 'experience' => '', 'interests' => []];

if ($step === 'register' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    foreach (array_keys($registrationValues) as $field) {
        $posted = $_POST[$field] ?? '';
        $registrationValues[$field] = is_string($posted) ? trim($posted) : '';
    }
    $passwordInput = $_POST['password'] ?? '';
    $password = is_string($passwordInput) ? $passwordInput : '';
    $confirmInput = $_POST['confirm_password'] ?? '';
    $confirmPassword = is_string($confirmInput) ? $confirmInput : '';

    if ($registrationValues['name'] === '') $errors['name'] = 'Please enter your full name.';
    if ($registrationValues['email'] === '') $errors['email'] = 'Please enter your email address.';
    elseif (!filter_var($registrationValues['email'], FILTER_VALIDATE_EMAIL)) $errors['email'] = 'Please enter a valid email address.';
    $passwordLength = preg_match_all('/./us', $password);
    if ($passwordLength === false || $passwordLength < 6) $errors['password'] = 'Password must contain at least 6 characters.';
    if ($confirmPassword !== $password) $errors['confirm_password'] = 'The passwords do not match.';
    $age = filter_var($registrationValues['age'], FILTER_VALIDATE_INT);
    if ($registrationValues['age'] === '' || $age === false || $age < 10 || $age > 100) $errors['age'] = 'Age must be a whole number from 10 to 100.';
    if (!in_array($registrationValues['gender'], ['Male', 'Female', 'Other'], true)) $errors['gender'] = 'Please select a gender.';

    if ($errors === []) {
        $_SESSION['registration'] = [
            'name' => $registrationValues['name'],
            'email' => $registrationValues['email'],
            'age' => $age,
            'gender' => $registrationValues['gender'],
        ];
        unset($_SESSION['survey']);
        header('Location: homework3.php?step=survey');
        exit;
    }
}

if ($step === 'survey') {
    $savedSurvey = $_SESSION['survey'] ?? [];
    $surveyValues = [
        'language' => is_string($savedSurvey['language'] ?? null) ? $savedSurvey['language'] : '',
        'experience' => is_string($savedSurvey['experience'] ?? null) ? $savedSurvey['experience'] : '',
        'interests' => is_array($savedSurvey['interests'] ?? null) ? $savedSurvey['interests'] : [],
    ];
    if ($_SERVER['REQUEST_METHOD'] === 'POST') {
        $language = $_POST['language'] ?? '';
        $experience = $_POST['experience'] ?? '';
        $interests = $_POST['interests'] ?? [];
        $surveyValues['language'] = is_string($language) ? $language : '';
        $surveyValues['experience'] = is_string($experience) ? $experience : '';
        if (!is_array($interests)) $interests = [];
        $interests = array_values(array_filter($interests, 'is_string'));
        $surveyValues['interests'] = array_values(array_intersect($interestOptions, $interests));

        if (!in_array($surveyValues['language'], $languages, true)) $errors['language'] = 'Please choose a programming language.';
        if (!in_array($surveyValues['experience'], $experiences, true)) $errors['experience'] = 'Please select your experience level.';
        if ($surveyValues['interests'] === []) $errors['interests'] = 'Select at least one interest.';
        if ($errors === []) {
            $_SESSION['survey'] = $surveyValues;
            header('Location: homework3.php?step=summary');
            exit;
        }
    }
}

$registration = $_SESSION['registration'] ?? [];
$survey = $_SESSION['survey'] ?? [];
$summaryInterests = is_array($survey['interests'] ?? null) ? $survey['interests'] : [];
?>
