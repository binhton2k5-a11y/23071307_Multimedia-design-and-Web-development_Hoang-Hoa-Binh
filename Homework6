/*
NORMALIZATION TO THIRD NORMAL FORM (3NF)
1NF: Every field contains one value. Authors and categories are not stored as
comma-separated lists in books; each association occupies a junction-table row.
Addresses are split into address line, city and country; an address line is the
smallest unit needed by this application.
2NF: book_authors and book_categories contain only their composite primary-key
columns. In order_items, both quantity and the agreed unit_price depend on the
whole (order_id, book_id) key, not on just the book or order. All other tables
have a single-column surrogate PK and any additional candidate keys shown.
3NF: Non-key attributes describe the key directly. Publisher details occur only
in publishers: books stores publisher_id but not publisher_name or website.
Author details and category descriptions occur only in their respective tables.
Customer profile data is not duplicated in orders. Shipping address fields are
facts about a particular order destination and need not match the current
customer address. Likewise order_items.unit_price is a historical transaction
price, not a copy that must track the current books.price.
DERIVED MONEY FIELDS REQUIRED BY THE BRIEF:
An item subtotal equals quantity * unit_price. An order total is the sum of its
item subtotals. Storing these as independently editable base columns would add
redundancy and update anomalies. The required subtotal and total are therefore
exposed as derived attributes in v_order_items and v_orders (defined below).
All ten required entity tables remain base tables in 3NF; the two read-only
reporting views add no persisted facts. Query v_orders to see the order header
including total; query v_order_items to see every line including subtotal.
BUSINESS ASSUMPTIONS:
All money is VND, with no delivery fee, tax or discount beyond each agreed unit
price. An order may temporarily have zero lines while being entered; its total
is zero. Before confirmation, the application must require at least one line.
One ISBN identifies one edition. The category hierarchy is a tree by business
rule; the parent FK ensures existence, while preventing cycles is an application
validation rule (not claimed to be enforced by the FK). Reviews need not be
verified purchases, although the sample reviews are all from delivered orders.
These synthetic authors, publishers, books, addresses, ISBNs and accounts are
illustrative classroom data, not verified real-world bibliographic records.
*/

SET NAMES utf8mb4;
-- Strict input validation for this import session; preserve existing SQL modes.
SET SESSION sql_mode = CONCAT_WS(',', @@SESSION.sql_mode, 'STRICT_ALL_TABLES');
CREATE DATABASE IF NOT EXISTS bookstore_db
    CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE bookstore_db;

-- Remove dependent objects before their parents; FK enforcement stays enabled.
DROP VIEW IF EXISTS v_orders;
DROP VIEW IF EXISTS v_order_items;
DROP TABLE IF EXISTS reviews;
DROP TABLE IF EXISTS order_items;
DROP TABLE IF EXISTS orders;
DROP TABLE IF EXISTS customers;
DROP TABLE IF EXISTS book_categories;
DROP TABLE IF EXISTS book_authors;
DROP TABLE IF EXISTS books;
DROP TABLE IF EXISTS categories;
DROP TABLE IF EXISTS publishers;
DROP TABLE IF EXISTS authors;

-- authors: One row per author; names are not assumed to be unique.
CREATE TABLE authors (
author_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(120) NOT NULL,
    biography TEXT,
    nationality VARCHAR(60) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- publishers: Publisher details are stored once and referenced by books.
CREATE TABLE publishers (
publisher_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    publisher_name VARCHAR(150) NOT NULL UNIQUE,
    address_line VARCHAR(200) NOT NULL,
    city VARCHAR(80) NOT NULL,
    country VARCHAR(80) NOT NULL DEFAULT 'Vietnam',
    website VARCHAR(255)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- categories: Optional parent_category_id represents sub-genres; NULL means a root category.
CREATE TABLE categories (
category_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    category_name VARCHAR(80) NOT NULL UNIQUE,
    description TEXT,
    parent_category_id INT UNSIGNED NULL,
    -- Do not delete a parent while child categories still refer to it.
    CONSTRAINT fk_categories_parent FOREIGN KEY (parent_category_id)
        REFERENCES categories (category_id) ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- books: One catalog row per ISBN/edition; the catalog price is the current price in VND.
CREATE TABLE books (
book_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    isbn VARCHAR(13) NOT NULL UNIQUE,
    title VARCHAR(200) NOT NULL,
    publisher_id INT UNSIGNED NOT NULL,
    price DECIMAL(12,2) NOT NULL,
    stock INT NOT NULL DEFAULT 0,
    publication_date DATE NOT NULL,
    description TEXT,
    -- Preserve books that still reference a publisher.
    CONSTRAINT fk_books_publisher FOREIGN KEY (publisher_id)
        REFERENCES publishers (publisher_id) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT chk_books_isbn CHECK (isbn REGEXP '^[0-9]{13}$'),
    CONSTRAINT chk_books_price CHECK (price > 0),
    CONSTRAINT chk_books_stock CHECK (stock >= 0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- book_authors: Resolves books M:N authors. The composite PK prevents duplicate associations.
CREATE TABLE book_authors (
book_id INT UNSIGNED NOT NULL,
    author_id INT UNSIGNED NOT NULL,
    PRIMARY KEY (book_id, author_id),
    -- Associations have no independent existence after either endpoint is deleted.
    CONSTRAINT fk_book_authors_book FOREIGN KEY (book_id)
        REFERENCES books (book_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_book_authors_author FOREIGN KEY (author_id)
        REFERENCES authors (author_id) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- book_categories: Resolves books M:N categories. The composite PK prevents duplicate associations.
CREATE TABLE book_categories (
book_id INT UNSIGNED NOT NULL,
    category_id INT UNSIGNED NOT NULL,
    PRIMARY KEY (book_id, category_id),
    CONSTRAINT fk_book_categories_book FOREIGN KEY (book_id)
        REFERENCES books (book_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_book_categories_category FOREIGN KEY (category_id)
        REFERENCES categories (category_id) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- customers: Customer profile and password hash; no plaintext password is stored.
CREATE TABLE customers (
customer_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(120) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    address_line VARCHAR(200) NOT NULL,
    city VARCHAR(80) NOT NULL,
    country VARCHAR(80) NOT NULL DEFAULT 'Vietnam',
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- orders: Order header. Shipping fields are a snapshot of this order destination, not the current customer address.
CREATE TABLE orders (
order_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    customer_id INT UNSIGNED NOT NULL,
    order_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    status ENUM('pending', 'paid', 'shipped', 'delivered', 'cancelled') NOT NULL DEFAULT 'pending',
    shipping_address_line VARCHAR(200) NOT NULL,
    shipping_city VARCHAR(80) NOT NULL,
    shipping_country VARCHAR(80) NOT NULL DEFAULT 'Vietnam',
    -- Keep customer identity for order history; cancel orders rather than delete history.
    CONSTRAINT fk_orders_customer FOREIGN KEY (customer_id)
        REFERENCES customers (customer_id) ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- order_items: One book per order. unit_price is the agreed historical price in VND, independent of books.price.
CREATE TABLE order_items (
order_id INT UNSIGNED NOT NULL,
    book_id INT UNSIGNED NOT NULL,
    quantity INT NOT NULL,
    unit_price DECIMAL(12,2) NOT NULL,
    PRIMARY KEY (order_id, book_id),
    -- Items belong to their order; removing an order removes its dependent items.
    CONSTRAINT fk_order_items_order FOREIGN KEY (order_id)
        REFERENCES orders (order_id) ON DELETE CASCADE ON UPDATE CASCADE,
    -- Preserve historical sales lines when a book is referenced.
    CONSTRAINT fk_order_items_book FOREIGN KEY (book_id)
        REFERENCES books (book_id) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT chk_order_items_quantity CHECK (quantity > 0),
    CONSTRAINT chk_order_items_unit_price CHECK (unit_price > 0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- reviews: At most one review per customer and book. Customers may update an existing review.
CREATE TABLE reviews (
review_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    customer_id INT UNSIGNED NOT NULL,
    book_id INT UNSIGNED NOT NULL,
    rating TINYINT NOT NULL,
    comment TEXT NOT NULL,
    review_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_reviews_customer_book UNIQUE (customer_id, book_id),
    -- Reviews are dependent content, unlike retained order history.
    CONSTRAINT fk_reviews_customer FOREIGN KEY (customer_id)
        REFERENCES customers (customer_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_reviews_book FOREIGN KEY (book_id)
        REFERENCES books (book_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT chk_reviews_rating CHECK (rating BETWEEN 1 AND 5)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Required derived line amount: evaluated on reading, never stored twice.
CREATE VIEW v_order_items AS
SELECT order_id, book_id, quantity, unit_price,
       CAST(quantity * unit_price AS DECIMAL(15,2)) AS subtotal
FROM order_items;

-- Required derived order total: pre-aggregate items before joining the header.
CREATE VIEW v_orders AS
SELECT o.order_id, o.customer_id, o.order_date, o.status,
       o.shipping_address_line, o.shipping_city, o.shipping_country,
       CAST(COALESCE(t.total, 0) AS DECIMAL(15,2)) AS total
FROM orders AS o
LEFT JOIN (
    SELECT order_id, SUM(subtotal) AS total
    FROM v_order_items
    GROUP BY order_id
) AS t ON t.order_id = o.order_id;

